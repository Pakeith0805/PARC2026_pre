# ~/parc_lora_workspace/lerobot （huggingface/lerobot, commit
# 30da8e687a6dfc617fcd94afc367ac7071c376ce, pip版と同じ0.6.0相当）に対する
# ローカルパッチ。lerobot-train実行時にPYTHONPATHで先頭挿入して使っている実体。
#
# 内容はどちらもログ出力ノイズ削減のみ（正しさには無関係）:
# 1. cfg.to_dict()の巨大なpformatダンプをinfo→debugに落とす
#    （lerobot-trainをsubprocess経由で起動しstdoutを1行ずつパースしている
#    notebook側の都合）。
# 2. tqdmプログレスバーを常時disable=Trueに（元は disable=inside_slurm() ）。
#    Slurm環境（IS計算サーバー等）では元々自動的にdisableされるので、
#    そちらに持ち越す場合はこのパッチ自体不要。
#
# 適用方法: git clone https://github.com/huggingface/lerobot したうえで
# git checkout 30da8e687a6dfc617fcd94afc367ac7071c376ce し、このdiffを
# git apply する。

diff --git a/src/lerobot/scripts/lerobot_train.py b/src/lerobot/scripts/lerobot_train.py
index 6e84585..c32b58a 100644
--- a/src/lerobot/scripts/lerobot_train.py
+++ b/src/lerobot/scripts/lerobot_train.py
@@ -229,7 +229,7 @@ def train(cfg: TrainPipelineConfig, accelerator: "Accelerator | None" = None):
 
     # Only log on main process
     if is_main_process:
-        logging.info(pformat(cfg.to_dict()))
+        logging.debug(pformat(cfg.to_dict()))
 
     # Initialize wandb only on main process
     if cfg.wandb.enable and cfg.wandb.project and is_main_process:
@@ -555,7 +555,7 @@ def train(cfg: TrainPipelineConfig, accelerator: "Accelerator | None" = None):
             total=cfg.steps - step,
             desc="Training",
             unit="step",
-            disable=inside_slurm(),
+            disable=True,
             position=0,
             leave=True,
         )
